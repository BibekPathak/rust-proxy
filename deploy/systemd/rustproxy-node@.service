[Unit]
Description=RustProxy node agent
Documentation=https://github.com/BibekP/rustproxy
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
User=rustproxy
Group=rustproxy
WorkingDirectory=/var/lib/rustproxy
ExecStart=/usr/local/bin/rustproxy node --config /etc/rustproxy/node-%i.toml
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
